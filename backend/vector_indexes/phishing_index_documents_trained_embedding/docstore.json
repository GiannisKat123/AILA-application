": "4", "metadata": {"id": "phishing_23", "source": "Phishing Scenarios", "doc_type": "explainer", "title": "Vishing (Voice Phishing)", "lang": "en"}, "hash": "3f496d68d3239a45a372854a11e000ff37954223c331a5a90d0c8f3dc71f62f1", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Attackers pose as bank officials or authorities and use intimidation to extract financial details.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 98, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "4da7b922-74eb-42b0-9793-a71d4c065741": {"__data__": {"id_": "4da7b922-74eb-42b0-9793-a71d4c065741", "embedding": null, "metadata": {"id": "phishing_24", "source": "Phishing Scenarios", "doc_type": "explainer", "title": "Vishing (Voice Phishing)", "lang": "en"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "5a62c01c-b673-4a9b-8987-81dffe4b9e78", "node_type": "4", "metadata": {"id": "phishing_24", "source": "Phishing Scenarios", "doc_type": "explainer", "title": "Vishing (Voice Phishing)", "lang": "en"}, "hash": "9572740eb2ae5d5615b1221db9729e9b3e83b885d7399927478778d8c57fe882", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Scenario:\n- Victims are coerced into giving away PINs, passwords, or other credentials under false pretenses of legal or financial emergencies.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 143, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}}