fa6090efa"], "metadata": {"id": "cybercrime_15", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}}}, "docstore/data": {"7b32b968-0427-4d2d-8631-af32f6b5c04d": {"__data__": {"id_": "7b32b968-0427-4d2d-8631-af32f6b5c04d", "embedding": null, "metadata": {"id": "cybercrime_1", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "a96b7418-ae4b-4fe8-97ab-7e8e49225eab", "node_type": "4", "metadata": {"id": "cybercrime_1", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "hash": "842ade8cb64d5413298e974e5bbfb4e4aabffd638bfc016def4fdb38bc6672d9", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": ". Anyone who, by knowingly presenting false facts as true or by unlawfully concealing or withholding true facts, damages another person's property by persuading someone to act, omission, or tolerance", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 199, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9d24f908-7aa9-4edf-9adc-84b748edcba8": {"__data__": {"id_": "9d24f908-7aa9-4edf-9adc-84b748edcba8", "embedding": null, "metadata": {"id": "cybercrime_2", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c125d0da-3186-4bc3-9307-11c1c9a58e85", "node_type": "4", "metadata": {"id": "cybercrime_2", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "hash": "ab3d510a7ec6c814c0cd12e4ec692becd2cf506d064c6932b685383fb6bd305f", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "or tolerance with the aim of obtaining, for themselves or another, an unlawful financial gain from the damage to that property shall be punished with imprisonment, \"and if the damage caused is", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 192, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "556402a7-93e0-47e5-86fa-671aa4c5ce2c": {"__data__": {"id_": "556402a7-93e0-47e5-86fa-671aa4c5ce2c", "embedding": null, "metadata": {"id": "cybercrime_3", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "f7f97d55-47b6-4e00-a175-facc1a54dce4", "node_type": "4", "metadata": {"id": "cybercrime_3", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "hash": "a31fdc4007dfe1f633fe0e5600fc852cbdeae05ce640cf1404fe37911e5e03d0", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "damage caused is particularly great, with imprisonment of at least three (3) months and a fine", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 94, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "a655cc73-9bf8-4ac7-898b-4cc16083f934": {"__data__": {"id_": "a655cc73-9bf8-4ac7-898b-4cc16083f934", "embedding": null, "metadata": {"id": "cybercrime_5", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "07fab725-965c-4f90-bf8c-bfcfb1f2a591", "node_type": "4", "metadata": {"id": "cybercrime_5", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "hash": "aee39eb207a846604cc927b98773418f6558de5de98f0554c208fe843bd58682", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "If the damage caused exceeds a total of one hundred and twenty thousand (120,000) euros, imprisonment of up to ten (10) years and a fine shall be imposed.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 154, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9b8e0e98-36c8-4467-b78f-49c68ae84531": {"__data__": {"id_": "9b8e0e98-36c8-4467-b78f-49c68ae84531", "embedding": null, "metadata": {"id": "cybercrime_7", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "857810d9-d071-41e9-aeb7-7147cc8cc915", "node_type": "4", "metadata": {"id": "cybercrime_7", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "hash": "40e5f7c56daafede139e35c3804dc2e0179ac1a124f5e80046dfd1fbabe4e1d8", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": ". If the fraud is directed directly against the legal entity of the Greek State, legal entities governed by public law, or local government organizations, and the damage caused exceeds a total of one", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 199, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "a7da0bf3-782b-41dd-bf62-a9038617ec11": {"__data__": {"id_": "a7da0bf3-782b-41dd-bf62-a9038617ec11", "embedding": null, "metadata": {"id": "cybercrime_8", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "58d7d0bc-3352-4839-a97b-8eae030770aa", "node_type": "4", "metadata": {"id": "cybercrime_8", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "hash": "f9dd9828f91420adcb245b62d15305cf6569812480341c04c282c4fd3c6663dd", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "a total of one hundred and twenty thousand (120,000) euros, a prison sentence of at least ten (10) years and a fine of up to one thousand (1,000) daily units shall be imposed", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 174, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "2c4914ce-4752-4e1d-b832-b7f0c1cf8085": {"__data__": {"id_": "2c4914ce-4752-4e1d-b832-b7f0c1cf8085", "embedding": null, "metadata": {"id": "cybercrime_9", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "c5570627-8d12-4142-818d-092f4c24980f", "node_type": "4", "metadata": {"id": "cybercrime_9", "title": "Fraud - Article 386 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "386", "lang": "en", "jurisdiction": "GR"}, "hash": "8979be3d79ff9ea145a035234a91d8c927d898d43751ec5b80a5215fd76d93f7", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": ". This offense shall be time-barred after twenty (20) years.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 60, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "0377f931-ebf4-45c3-9e45-3e4c03406989": {"__data__": {"id_": "0377f931-ebf4-45c3-9e45-3e4c03406989", "embedding": null, "metadata": {"id": "cybercrime_10", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "a6c5b6b6-d6bd-414b-b00b-0382c8974fce", "node_type": "4", "metadata": {"id": "cybercrime_10", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "hash": "997410a3141ee99382e9df265e460953fcf68ddf253adcf9c0cd281bdf15a06e", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Everyone who obtains access to data recorded in a computer or in the external memory of a computer or transmitted by telecommunication systems shall be punished with imprisonment for up to six months", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 199, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "ff048877-fdd8-49d7-95df-53987a25bac2": {"__data__": {"id_": "ff048877-fdd8-49d7-95df-53987a25bac2", "embedding": null, "metadata": {"id": "cybercrime_11", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "2fce9591-65fa-4e54-881b-f45af470c5fc", "node_type": "4", "metadata": {"id": "cybercrime_11", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "hash": "c058801ab5088e766d8a81442ab754e0833a2dd61230b5e019a61d435ea1c347", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "up to six months or by a fine from 29 to 15,000 Euro, under the condition that these acts have been committed without right, especially in violation of prohibitions or of security measures taken by", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 197, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "7352492f-39e1-456b-954c-bad03f5e5a57": {"__data__": {"id_": "7352492f-39e1-456b-954c-bad03f5e5a57", "embedding": null, "metadata": {"id": "cybercrime_12", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "0dafecc9-e04b-4147-b658-137c35daa033", "node_type": "4", "metadata": {"id": "cybercrime_12", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "hash": "7a83c79a94167da2ffc039ae521dabec4c58398ba75c1289cc6aa85c082bb5f8", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "measures taken by the legal holder", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 34, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "90b0e8ab-564a-4086-9caf-b62cf915f54a": {"__data__": {"id_": "90b0e8ab-564a-4086-9caf-b62cf915f54a", "embedding": null, "metadata": {"id": "cybercrime_13", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "637a13ee-bf9a-46c8-b293-21b81630503d", "node_type": "4", "metadata": {"id": "cybercrime_13", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "hash": "e69b4b6744a864c59031def2eaaecd031f394d9f09a440fc92dec3e00501aa4c", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": ". If the act concerns the international relations or the security of the State, he shall be punished according to Article 148.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 126, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "c13ace60-87c1-4b5b-bea7-8c5db1e50d60": {"__data__": {"id_": "c13ace60-87c1-4b5b-bea7-8c5db1e50d60", "embedding": null, "metadata": {"id": "cybercrime_14", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "a8a09c83-a363-4c84-953d-b81c973ed594", "node_type": "4", "metadata": {"id": "cybercrime_14", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_type": "criminal_statute", "law": "unknown", "article_number": "370", "lang": "en", "jurisdiction": "GR"}, "hash": "bf161f08c02e6d84d2f45ad77f03448e4d627c46a81bbbad35346fc1ea1d6c9e", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "If the offender is in the service of the legal holder of the data, the act of the preceding paragraph shall be punished only if it has been explicitly prohibited by internal regulations or by a", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 193, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "1f9e4b60-c5e8-4afb-ad48-084fa6090efa": {"__data__": {"id_": "1f9e4b60-c5e8-4afb-ad48-084fa6090efa", "embedding": null, "metadata": {"id": "cybercrime_15", "title": "Unauthorized data access - Article 370\u0393 \u03a0\u039a", "source": "Greek Cybercrime Law", "doc_typ